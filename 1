<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Linux Revision</title>

  <style>
    * {
      box-sizing: border-box;
    }

    :root {
      --background: #f5f7fb;
      --surface: #ffffff;
      --text: #172033;
      --muted: #64748b;
      --border: #dbe4f0;
      --primary: #4f46e5;
      --primary-dark: #3730a3;
      --success: #15803d;
      --warning: #b45309;
      --danger: #b91c1c;
      --due-background: #fff7ed;
      --selected-background: #eef2ff;
    }

    body {
      margin: 0;
      padding: 28px;
      font-family: Arial, sans-serif;
      line-height: 1.65;
      color: var(--text);
      background: var(--background);
    }

    button,
    input {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    .container {
      width: min(1100px, 100%);
      margin: auto;
    }

    .top-link {
      display: inline-block;
      margin-bottom: 18px;
      color: var(--primary);
      font-weight: bold;
      text-decoration: none;
    }

    .hero,
    .panel,
    .revision-card {
      padding: 25px;
      margin-bottom: 20px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      box-shadow: 0 5px 18px rgba(15, 23, 42, 0.06);
    }

    .hero {
      color: white;
      background:
        linear-gradient(135deg, #111827, #4338ca);
      border: 0;
    }

    .hero h1 {
      margin-top: 0;
      margin-bottom: 8px;
    }

    .hero p {
      margin-bottom: 0;
      color: #e0e7ff;
    }

    .queue-header,
    .selected-header,
    .actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      flex-wrap: wrap;
    }

    .queue-count {
      font-size: 34px;
      font-weight: bold;
      color: var(--primary);
    }

    .muted {
      color: var(--muted);
    }

    .primary-button,
    .secondary-button,
    .success-button,
    .warning-button,
    .answer-button,
    .copy-button {
      padding: 11px 17px;
      border-radius: 9px;
      font-weight: bold;
      border: 0;
    }

    .primary-button {
      color: white;
      background: var(--primary);
    }

    .primary-button:hover {
      background: var(--primary-dark);
    }

    .secondary-button,
    .answer-button,
    .copy-button {
      color: #1e293b;
      background: #e2e8f0;
    }

    .success-button {
      color: white;
      background: var(--success);
    }

    .warning-button {
      color: white;
      background: var(--warning);
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.55;
    }

    .due-preview {
      display: flex;
      gap: 9px;
      flex-wrap: wrap;
      margin-top: 18px;
    }

    .due-chip {
      padding: 8px 12px;
      color: #9a3412;
      background: #ffedd5;
      border: 1px solid #fdba74;
      border-radius: 999px;
    }

    .search-input {
      width: 100%;
      padding: 14px;
      margin: 12px 0 16px;
      font-size: 16px;
      border: 1px solid #cbd5e1;
      border-radius: 10px;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.15);
    }

    .topic-browser {
      display: grid;
      grid-template-columns:
        repeat(auto-fit, minmax(240px, 1fr));
      gap: 12px;
      max-height: 430px;
      overflow-y: auto;
      padding: 4px;
    }

    .topic-option {
      padding: 15px;
      text-align: left;
      color: var(--text);
      background: white;
      border: 1px solid var(--border);
      border-radius: 11px;
    }

    .topic-option:hover {
      border-color: #818cf8;
      transform: translateY(-1px);
    }

    .topic-option.selected {
      background: var(--selected-background);
      border: 2px solid var(--primary);
    }

    .topic-option.due:not(.selected) {
      background: var(--due-background);
      border-color: #fdba74;
    }

    .topic-name {
      display: block;
      font-weight: bold;
    }

    .topic-status {
      display: block;
      margin-top: 6px;
      color: var(--muted);
      font-size: 13px;
    }

    .no-results {
      grid-column: 1 / -1;
      padding: 24px;
      text-align: center;
      color: var(--muted);
    }

    .workspace-title {
      margin: 0;
    }

    .topic-link {
      color: var(--primary);
      font-weight: bold;
      text-decoration: none;
    }

    .schedule-status {
      margin-top: 7px;
      color: var(--muted);
    }

    .revision-grid {
      display: grid;
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .revision-card {
      margin: 0;
    }

    .revision-card h3 {
      margin-top: 0;
    }

    .answer {
      padding: 15px;
      margin-top: 14px;
      background: #eff6ff;
      border-left: 4px solid #2563eb;
      border-radius: 8px;
    }

    .answer[hidden] {
      display: none;
    }

    pre {
      padding: 16px;
      overflow-x: auto;
      color: #d1fae5;
      background: #111827;
      border-radius: 10px;
      white-space: pre-wrap;
    }

    .completion-panel {
      margin-top: 20px;
      text-align: center;
    }

    .completion-panel h2 {
      margin-top: 0;
    }

    .completion-message {
      min-height: 25px;
      font-weight: bold;
      color: var(--success);
    }

    .schedule {
      margin: 8px 0 0;
      color: var(--muted);
      font-size: 14px;
    }

    @media (max-width: 750px) {
      body {
        padding: 15px;
      }

      .hero,
      .panel,
      .revision-card {
        padding: 19px;
      }

      .revision-grid {
        grid-template-columns: 1fr;
      }

      .topic-browser {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

<main class="container">

  <a class="top-link" href="index.html">
    ← Home
  </a>

  <section class="hero">
    <h1>🔁 Linux Revision</h1>

    <p>
      Due reviews, topic search and focused 5–15 minute revision
      in one place.
    </p>
  </section>

  <section class="panel">

    <div class="queue-header">

      <div>
        <h2>🧠 Today’s Queue</h2>

        <div>
          <span id="dueCount"
                class="queue-count">0</span>
          topics due
        </div>

        <p class="schedule">
          Schedule: 1 → 3 → 7 → 15 → 30 days
        </p>
      </div>

      <button
        id="startNextButton"
        class="primary-button"
        onclick="startNextDue()">
        Start Next Due Topic
      </button>

    </div>

    <div id="duePreview"
         class="due-preview">
    </div>

  </section>

  <section class="panel">

    <h2>🔎 Revise Any Topic</h2>

    <input
      id="topicSearch"
      class="search-input"
      type="search"
      placeholder="Search all 22 Linux topics..."
      oninput="renderTopicBrowser()"
      autocomplete="off"
    >

    <div id="topicBrowser"
         class="topic-browser">
    </div>

  </section>

  <section id="revisionWorkspace"
           class="panel">

    <div class="selected-header">

      <div>
        <h2 id="selectedTopicName"
            class="workspace-title">
          Select a topic
        </h2>

        <p id="selectedTopicStatus"
           class="schedule-status">
        </p>
      </div>

      <a id="fullTopicLink"
         class="topic-link"
         href="linux.html">
        Open Full Topic →
      </a>

    </div>

    <div class="revision-grid">

      <article class="revision-card">

        <h3>1️⃣ 30-Second Recall</h3>

        <p id="recallQuestion"></p>

        <button
          class="answer-button"
          onclick="toggleAnswer('recallAnswer', this)">
          Show Answer
        </button>

        <div id="recallAnswer"
             class="answer"
             hidden>
        </div>

      </article>

      <article class="revision-card">

        <h3>2️⃣ Interview Recall</h3>

        <p id="interviewQuestion"></p>

        <button
          class="answer-button"
          onclick="toggleAnswer('interviewAnswer', this)">
          Show Answer
        </button>

        <div id="interviewAnswer"
             class="answer"
             hidden>
        </div>

      </article>

      <article class="revision-card">

        <h3>3️⃣ Production Scenario</h3>

        <p id="scenarioQuestion"></p>

        <button
          class="answer-button"
          onclick="toggleAnswer('scenarioAnswer', this)">
          Show Debug Approach
        </button>

        <div id="scenarioAnswer"
             class="answer"
             hidden>
          <ol id="scenarioSteps"></ol>
        </div>

      </article>

      <article class="revision-card">

        <h3>4️⃣ Hands-On Task</h3>

        <p id="taskLabel"></p>

        <pre id="taskCommands"></pre>

        <button
          class="copy-button"
          onclick="copyCommands(this)">
          Copy Commands
        </button>

      </article>

    </div>

    <div class="panel completion-panel">

      <h2>✅ Finish This Revision</h2>

      <p>
        First answer without opening the solution.
        Then choose the honest result.
      </p>

      <div class="actions">

        <button
          class="success-button"
          onclick="markSelectedReviewed()">
          I Remembered — Mark Reviewed
        </button>

        <button
          class="warning-button"
          onclick="reviewSelectedTomorrow()">
          Needs Practice — Tomorrow
        </button>

      </div>

      <p id="completionMessage"
         class="completion-message">
      </p>

    </div>

  </section>

</main>

<script src="revision-data.js"></script>

<script>
  const intervals =
    window.revisionIntervals;

  const topics =
    window.revisionTopics;

  let selectedTopicId = null;

  function localDateString(date = new Date()) {
    const year =
      date.getFullYear();

    const month =
      String(date.getMonth() + 1)
        .padStart(2, "0");

    const day =
      String(date.getDate())
        .padStart(2, "0");

    return `${year}-${month}-${day}`;
  }

  function addDays(days) {
    const date = new Date();

    date.setHours(12, 0, 0, 0);
    date.setDate(date.getDate() + days);

    return localDateString(date);
  }

  function getTopicData(id) {
    try {
      const saved =
        localStorage.getItem("review_" + id);

      if (!saved) {
        return {
          level: 0,
          nextReview: null,
          lastReviewed: null
        };
      }

      const parsed =
        JSON.parse(saved);

      return {
        level:
          Number.isInteger(parsed.level)
            ? parsed.level
            : 0,

        nextReview:
          parsed.nextReview || null,

        lastReviewed:
          parsed.lastReviewed || null
      };
    } catch (error) {
      return {
        level: 0,
        nextReview: null,
        lastReviewed: null
      };
    }
  }

  function saveTopicData(id, data) {
    localStorage.setItem(
      "review_" + id,
      JSON.stringify(data)
    );
  }

  function isDue(data) {
    if (!data.nextReview) {
      return true;
    }

    return (
      data.nextReview <=
      localDateString()
    );
  }

  function topicStatus(topic) {
    const data =
      getTopicData(topic.id);

    if (!data.nextReview) {
      return "🔥 Ready for first review";
    }

    if (isDue(data)) {
      return "🔥 Due today";
    }

    return "✅ Next: " + data.nextReview;
  }

  function getDueTopics() {
    return topics.filter(function (topic) {
      return isDue(
        getTopicData(topic.id)
      );
    });
  }

  function renderQueueSummary() {
    const dueTopics =
      getDueTopics();

    document.getElementById("dueCount")
      .textContent = dueTopics.length;

    const startButton =
      document.getElementById(
        "startNextButton"
      );

    startButton.disabled =
      dueTopics.length === 0;

    const preview =
      document.getElementById(
        "duePreview"
      );

    preview.innerHTML = "";

    if (dueTopics.length === 0) {
      const message =
        document.createElement("span");

      message.className = "muted";
      message.textContent =
        "🎉 All scheduled reviews are complete.";

      preview.appendChild(message);
      return;
    }

    dueTopics
      .slice(0, 6)
      .forEach(function (topic) {
        const button =
          document.createElement("button");

        button.className = "due-chip";
        button.textContent = topic.name;

        button.addEventListener(
          "click",
          function () {
            selectTopic(topic.id, true);
          }
        );

        preview.appendChild(button);
      });

    if (dueTopics.length > 6) {
      const more =
        document.createElement("span");

      more.className = "due-chip";
      more.textContent =
        "+" +
        (dueTopics.length - 6) +
        " more";

      preview.appendChild(more);
    }
  }

  function renderTopicBrowser() {
    const search =
      document.getElementById(
        "topicSearch"
      )
      .value
      .trim()
      .toLowerCase();

    const browser =
      document.getElementById(
        "topicBrowser"
      );

    browser.innerHTML = "";

    const filtered =
      topics.filter(function (topic) {
        const searchable =
          (
            topic.name +
            " " +
            topic.keywords
          )
          .toLowerCase();

        return searchable.includes(search);
      });

    if (filtered.length === 0) {
      const message =
        document.createElement("div");

      message.className = "no-results";
      message.textContent =
        "No matching Linux topic found.";

      browser.appendChild(message);
      return;
    }

    filtered.forEach(function (topic) {
      const data =
        getTopicData(topic.id);

      const button =
        document.createElement("button");

      button.className = "topic-option";

      if (isDue(data)) {
        button.classList.add("due");
      }

      if (topic.id === selectedTopicId) {
        button.classList.add("selected");
      }

      const name =
        document.createElement("span");

      name.className = "topic-name";
      name.textContent = topic.name;

      const status =
        document.createElement("span");

      status.className = "topic-status";
      status.textContent =
        topicStatus(topic);

      if (
        localStorage.getItem(topic.name) ===
        "done"
      ) {
        status.textContent +=
          " • Course completed";
      }

      button.appendChild(name);
      button.appendChild(status);

      button.addEventListener(
        "click",
        function () {
          selectTopic(topic.id, true);
        }
      );

      browser.appendChild(button);
    });
  }

  function hideAllAnswers() {
    document
      .querySelectorAll(".answer")
      .forEach(function (answer) {
        answer.hidden = true;
      });

    document
      .querySelectorAll(".answer-button")
      .forEach(function (button) {
        button.textContent =
          button.parentElement
            .querySelector("h3")
            .textContent
            .includes("Production")
              ? "Show Debug Approach"
              : "Show Answer";
      });
  }

  function selectTopic(id, shouldScroll) {
    const topic =
      topics.find(function (item) {
        return item.id === id;
      });

    if (!topic) {
      return;
    }

    selectedTopicId = topic.id;

    document.getElementById(
      "selectedTopicName"
    ).textContent = topic.name;

    document.getElementById(
      "selectedTopicStatus"
    ).textContent =
      topicStatus(topic);

    document.getElementById(
      "fullTopicLink"
    ).href = topic.page;

    document.getElementById(
      "recallQuestion"
    ).textContent =
      topic.recallQuestion;

    document.getElementById(
      "recallAnswer"
    ).textContent =
      topic.recallAnswer;

    document.getElementById(
      "interviewQuestion"
    ).textContent =
      topic.interviewQuestion;

    document.getElementById(
      "interviewAnswer"
    ).textContent =
      topic.interviewAnswer;

    document.getElementById(
      "scenarioQuestion"
    ).textContent =
      topic.scenarioQuestion;

    const scenarioList =
      document.getElementById(
        "scenarioSteps"
      );

    scenarioList.innerHTML = "";

    topic.scenarioAnswer.forEach(
      function (step) {
        const item =
          document.createElement("li");

        item.textContent = step;
        scenarioList.appendChild(item);
      }
    );

    document.getElementById(
      "taskLabel"
    ).textContent =
      topic.taskLabel;

    document.getElementById(
      "taskCommands"
    ).textContent =
      topic.commands.join("\n");

    document.getElementById(
      "completionMessage"
    ).textContent = "";

    hideAllAnswers();
    renderTopicBrowser();

    const url =
      new URL(window.location.href);

    url.searchParams.set(
      "topic",
      topic.id
    );

    history.replaceState(
      null,
      "",
      url
    );

    if (shouldScroll) {
      document.getElementById(
        "revisionWorkspace"
      )
      .scrollIntoView({
        behavior: "smooth",
        block: "start"
      });
    }
  }

  function startNextDue() {
    const dueTopics =
      getDueTopics();

    if (dueTopics.length > 0) {
      selectTopic(
        dueTopics[0].id,
        true
      );
    }
  }

  function toggleAnswer(id, button) {
    const answer =
      document.getElementById(id);

    answer.hidden =
      !answer.hidden;

    if (answer.hidden) {
      button.textContent =
        id === "scenarioAnswer"
          ? "Show Debug Approach"
          : "Show Answer";
    } else {
      button.textContent =
        "Hide Answer";
    }
  }

  async function copyCommands(button) {
    const commands =
      document.getElementById(
        "taskCommands"
      ).textContent;

    try {
      await navigator.clipboard
        .writeText(commands);

      button.textContent = "✅ Copied";

      setTimeout(function () {
        button.textContent =
          "Copy Commands";
      }, 1500);
    } catch (error) {
      button.textContent =
        "Copy unavailable";
    }
  }

  function markSelectedReviewed() {
    if (!selectedTopicId) {
      return;
    }

    const data =
      getTopicData(selectedTopicId);

    const currentLevel =
      Math.min(
        data.level,
        intervals.length - 1
      );

    const days =
      intervals[currentLevel];

    data.nextReview =
      addDays(days);

    data.lastReviewed =
      localDateString();

    data.level =
      Math.min(
        currentLevel + 1,
        intervals.length - 1
      );

    saveTopicData(
      selectedTopicId,
      data
    );

    document.getElementById(
      "completionMessage"
    ).textContent =
      "✅ Reviewed. Next review: " +
      data.nextReview;

    refreshRevisionUI();
  }

  function reviewSelectedTomorrow() {
    if (!selectedTopicId) {
      return;
    }

    const data =
      getTopicData(selectedTopicId);

    data.level = 0;
    data.lastReviewed =
      localDateString();

    data.nextReview =
      addDays(1);

    saveTopicData(
      selectedTopicId,
      data
    );

    document.getElementById(
      "completionMessage"
    ).textContent =
      "📌 Scheduled again for tomorrow: " +
      data.nextReview;

    refreshRevisionUI();
  }

  function refreshRevisionUI() {
    renderQueueSummary();
    renderTopicBrowser();

    const topic =
      topics.find(function (item) {
        return item.id === selectedTopicId;
      });

    if (topic) {
      document.getElementById(
        "selectedTopicStatus"
      ).textContent =
        topicStatus(topic);
    }
  }

  function initializeRevision() {
    renderQueueSummary();

    const requestedId =
      new URLSearchParams(
        window.location.search
      ).get("topic");

    const requestedTopic =
      topics.find(function (topic) {
        return topic.id === requestedId;
      });

    const firstDue =
      getDueTopics()[0];

    const initialTopic =
      requestedTopic ||
      firstDue ||
      topics[0];

    selectTopic(
      initialTopic.id,
      false
    );

    renderTopicBrowser();
  }

  initializeRevision();
</script>

</body>
</html>
